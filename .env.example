# Database settings
DATABASE_URL=postgresql://streetraceing:streetraceing@localhost:5433/streetraceing
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000

# Admin panel settings
ADMIN_PASSWORD=replace-with-a-long-private-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Cloudinary Free plan credentials from Console Settings > API Keys.
# Keep API_SECRET server-only. The browser receives only short-lived signed upload parameters.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional server-only token for the public GitHub commit feed.
# Public data works without it, but a fine-grained read-only token raises API limits.
GITHUB_TOKEN=

# Optional Vercel observability. It creates extra CDN/Edge requests.
VERCEL_ANALYTICS_ENABLED=false
# A value between 0 and 1. For example, 0.1 records roughly 10% of visits.
VERCEL_SPEED_INSIGHTS_SAMPLE_RATE=0
