DATABASE_URL=postgresql://streetraceing:streetraceing@localhost:5433/streetraceing
ADMIN_PASSWORD=replace-with-a-long-private-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional Vercel observability. It creates extra CDN/Edge requests.
VERCEL_ANALYTICS_ENABLED=false
# A value between 0 and 1. For example, 0.1 records roughly 10% of visits.
VERCEL_SPEED_INSIGHTS_SAMPLE_RATE=0
